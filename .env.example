# ── Cliente (Vite) — archivo .env en la raíz, NUNCA commitear ──────────────

# Proyecto Supabase → Settings → API
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="tu-anon-key"

# "true" = login Google + aprobación manual. "false" = demo sin auth.
VITE_AUTH_ENABLED="false"

# ── Supabase Edge Functions (Dashboard → Edge Functions → Secrets) ─────────
# No van en .env del cliente. Ver docs/SETUP.md para detalle.
#
# Auth y emails (si VITE_AUTH_ENABLED=true):
#   RESEND_API_KEY       — API key de https://resend.com (emails de aprobación)
#   OWNER_EMAIL          — email del admin que aprueba accesos
#   FROM_EMAIL           — remitente verificado en Resend (ej. onboarding@tudominio.com)
#
# Telegram + Gemini (opcional):
#   GEMINI_API_KEY       — https://aistudio.google.com/apikey
#   GEMINI_MODEL         — opcional; por defecto gemini-3.1-flash-lite
#   TELEGRAM_BOT_TOKEN   — token de @BotFather
#   TELEGRAM_BOT_USERNAME — username del bot sin @
#   TELEGRAM_WEBHOOK_SECRET — string aleatorio para proteger el webhook
#
# Buscador de imágenes (A6, opcional):
#   UNSPLASH_ACCESS_KEY  — https://unsplash.com/oauth/applications (Access Key)
#
# Inyectadas automáticamente por Supabase al desplegar functions:
#   SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

# ── GitHub Actions (repo → Settings → Secrets) — keep-alive plan free ─────
#   SUPABASE_URL        (= mismo valor que VITE_SUPABASE_URL)
#   SUPABASE_ANON_KEY   (= mismo valor que VITE_SUPABASE_ANON_KEY)
